{
    "info": {
        "name": "Agentino connection tokens",
        "description": "Who manages the tokens of the output connections and how a sign-in at the receiving server is used. Run by Run-CiTests.ps1.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "00 Bootstrap",
            "item": [
                {
                    "name": "su signs in",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const payload = json.data && json.data.Authorization;",
                                    "pm.test('Authorization answered', function () { pm.expect(json.errors, JSON.stringify(json.errors)).to.eql(undefined); pm.expect(payload, JSON.stringify(json)).to.be.an('object'); });",
                                    "pm.test('su token', function () { pm.expect(payload.token).to.be.a('string').and.not.empty; });",
                                    "pm.environment.set('su_token', payload.token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query Authorization { Authorization(input: { login: \"{{su_login}}\", password: \"{{su_password}}\" }) { token } }",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}",
                            "host": [
                                "{{base_url}}"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "su adds an ordinary user",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.environment.set('ct_user_id', pm.variables.replaceIn('{{$guid}}'));",
                                    "pm.environment.set('ct_user_login', 'ct.probe.' + Date.now());"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const payload = json.data && json.data.UserAdd;",
                                    "pm.test('UserAdd answered', function () { pm.expect(json.errors, JSON.stringify(json.errors)).to.eql(undefined); pm.expect(payload, JSON.stringify(json)).to.be.an('object'); });",
                                    "pm.test('added', function () { pm.expect(payload.id).to.eql(pm.environment.get('ct_user_id')); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "x-authentication-token",
                                "value": "{{su_token}}"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation UserAdd { UserAdd(input: { id: \"{{ct_user_id}}\", typeId: \"User\", productId: \"Agentino\", item: { id: \"{{ct_user_id}}\", productId: \"Agentino\", name: \"Connection token probe\", username: \"{{ct_user_login}}\", password: \"CtProbe_2026x\", email: \"{{ct_user_login}}@test.local\", groups: [], roles: [], permissions: [], systemInfos: [] } }) { id } }",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}",
                            "host": [
                                "{{base_url}}"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "the ordinary user signs in",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const payload = json.data && json.data.Authorization;",
                                    "pm.test('Authorization answered', function () { pm.expect(json.errors, JSON.stringify(json.errors)).to.eql(undefined); pm.expect(payload, JSON.stringify(json)).to.be.an('object'); });",
                                    "pm.test('user token', function () { pm.expect(payload.token).to.be.a('string').and.not.empty; });",
                                    "pm.environment.set('user_token', payload.token);"
                                ]
                            }
                        }
                    ],
