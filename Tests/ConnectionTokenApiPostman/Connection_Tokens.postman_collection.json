        {
            "name": "02 Sign-ins at the receiving server",
            "item": [
                {
                    "name": "su reads the token of a connection",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const payload = json.data && json.data.GetConnectionToken;",
                                    "pm.test('GetConnectionToken answered', function () { pm.expect(json.errors, JSON.stringify(json.errors)).to.eql(undefined); pm.expect(payload, JSON.stringify(json)).to.be.an('object'); });",
                                    "pm.test('no token held', function () { pm.expect(payload.token || null).to.eql(null); });",
                                    "pm.test('no token can be issued for a service of no agent, and why', function () { pm.expect(payload.canIssue).to.eql(false); pm.expect(payload.cannotIssueReason).to.match(/The service 'ct-service' of agent '[^']+' is unknown/); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "x-authentication-token",
                                "value": "{{su_token}}"
                            },
                            {
                                "key": "clientid",
                                "value": "{{client_id}}"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetConnectionToken { GetConnectionToken(input: { serviceId: \"ct-service\", connectionId: \"ct-connection\" }) { token { tokenId } canIssue cannotIssueReason } }",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}",
                            "host": [
                                "{{base_url}}"
                            ]
                        }
                    },
                    "response": []
                },
