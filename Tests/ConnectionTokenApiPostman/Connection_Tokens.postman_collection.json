                    "name": "GetConnectionToken: anonymous is refused",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const messages = (json.errors || []).map(function (e) { return e.message || ''; }).join(' | ');",
                                    "pm.test('refused: /Connection tokens are managed by a superuser session of Agentino/', function () { pm.expect(messages, JSON.stringify(json)).to.match(/Connection tokens are managed by a superuser session of Agentino/); });",
                                    "pm.test('no data', function () { const data = json.data || {}; Object.keys(data).forEach(function (k) { pm.expect(data[k], k).to.eql(null); }); });"
