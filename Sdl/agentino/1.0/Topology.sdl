schema {
	query: Query
	mutation: Mutation
	namespace: agentino
	version: 1.0
}

import {
	"Services.sdl"
}

type Link {
	id: ID!
}

# Kind of a topology node. Agents and groups are composite nodes containing other nodes.
enum TopologyNodeType {
	SERVICE
	AGENT
	GROUP
}

type Service {
	id: ID!
	agentId: ID!
	x: Double
	y: Double
	width: Integer
	mainText: String
	secondText: String
	thirdText: String
	icon1: String
	icon2: String
	status: ServiceStatus
	links: [Link]
	selected: Boolean
	hasError: Boolean
	isComposite: Boolean
	agentOnline: Boolean
	# ID of the composite node (agent or group) containing this node; empty for root nodes
	parentId: ID
	nodeType: TopologyNodeType
}

type TopologyNodeInfo {
	id: ID!
	name: String
}

type Topology {
	services: [Service]
	# Services that are not in the requested user-defined view (they can be added to it); empty for the default view
	availableServices: [TopologyNodeInfo]
	# The same services as availableServices with all data of a node (status, links, ...): the client adds
	# them to its local draft of the view and shows them before the view is saved
	availableServiceNodes: [Service]
}

# Views are different ways to group the topology nodes. The default view (empty view ID) groups
# services by agents; in the other views services are grouped freely, independently of agents.
input GetTopologyInput {
	viewId: ID
}

input ServiceCoordinateInput {
	id: ID!
	x: Double
	y: Double
}

# State of a user-defined group of a view (see SaveTopologyInput.groups)
input TopologyGroupInput {
	# ID of an existing group of the view, or a new ID (generated by the client) creating the group
	id: ID!
	name: String!
	x: Double
	y: Double
	# IDs of the direct members of the group (services, agents, groups of the same view)
	memberIds: [ID]
}

# The client edits a view locally (draft) and saves its whole state with one SaveTopology.
input SaveTopologyInput {
	viewId: ID
	# Positions of the nodes (services, agents, groups)
	services: [ServiceCoordinateInput]
	# All groups of the view (optional). If given, the groups of the view are replaced by them: groups
	# not listed are removed, new IDs create groups, names, positions and members are updated.
	# Not given: only the positions are saved (e.g. the agent, which has no groups).
	groups: [TopologyGroupInput]
	# Services shown in the user-defined view (optional; ignored for the default view). If given,
	# they replace the services of the view.
	nodeIds: [ID]
}

type SaveTopologyResponse {
	successful: Boolean!
}

input CreateTopologyGroupInput {
	viewId: ID
	name: String!
	# Group containing the new group; empty for the root level
	parentId: ID
	x: Double
	y: Double
	# ID of the new group; empty generates a new ID (a given ID recreates a removed group, e.g. on undo)
	id: ID
}

type CreateTopologyGroupResponse {
	id: ID!
}

input MoveTopologyNodesInput {
	viewId: ID
	nodeIds: [ID]
	# Target group; empty moves the nodes back to their default place (service: own agent in the default view, otherwise root)
	parentId: ID
}

input RemoveTopologyGroupInput {
	id: ID!
}

input RenameTopologyGroupInput {
	id: ID!
	name: String!
}

# Removes nodes (services) from a user-defined view only; the services themselves are not deleted
input RemoveFromTopologyViewInput {
	viewId: ID!
	nodeIds: [ID]
}

# Adds services to a user-defined view (a new view is empty)
input AddToTopologyViewInput {
	viewId: ID!
	nodeIds: [ID]
	# Group of the view receiving the services; empty for the root level
	parentId: ID
}

type TopologyGroupResponse {
	successful: Boolean!
}

type TopologyViewInfo {
	id: ID!
	name: String
	# Names of the services and groups of the view (used to find a view by its content)
	nodeNames: [String]
}

# User-defined views; the default view (grouping by agents) is not listed
type TopologyViewList {
	views: [TopologyViewInfo]
	# Names of the agents, services and groups of the default view
	agentsViewNodeNames: [String]
}

input CreateTopologyViewInput {
	name: String!
}

type CreateTopologyViewResponse {
	id: ID!
}

input RemoveTopologyViewInput {
	id: ID!
}

# Restores a removed view with its groups (e.g. on undo)
input RestoreTopologyViewInput {
	id: ID!
}

type Query {
	GetTopology (input: GetTopologyInput): Topology!
	GetTopologyViews: TopologyViewList!
}

type Mutation {
	SaveTopology (input: SaveTopologyInput): SaveTopologyResponse!
	CreateTopologyGroup (input: CreateTopologyGroupInput): CreateTopologyGroupResponse!
	MoveTopologyNodes (input: MoveTopologyNodesInput): TopologyGroupResponse!
	RemoveTopologyGroup (input: RemoveTopologyGroupInput): TopologyGroupResponse!
	RenameTopologyGroup (input: RenameTopologyGroupInput): TopologyGroupResponse!
	RemoveFromTopologyView (input: RemoveFromTopologyViewInput): TopologyGroupResponse!
	AddToTopologyView (input: AddToTopologyViewInput): TopologyGroupResponse!
	CreateTopologyView (input: CreateTopologyViewInput): CreateTopologyViewResponse!
	RemoveTopologyView (input: RemoveTopologyViewInput): TopologyGroupResponse!
	RestoreTopologyView (input: RestoreTopologyViewInput): TopologyGroupResponse!
}

