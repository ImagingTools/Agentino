schema {
	query: Query
	mutation: Mutation
	namespace: agentino
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
}

# One row of the "Update" page: a service type (the software product) installed on the agents.
type ServiceUpdateItem {
	# Service type ID (falls back to the service name for services without a type)
	id: ID!
	name: String!
	# Number of agents having at least one service of this type
	agentCount: Int
	# Latest available version of the software; not provided yet
	latestVersion: String
	# Services of this type are updated automatically; not provided yet
	autoUpdate: Boolean
}

type ServiceUpdateListPayload {
	items: [ServiceUpdateItem]!
}

input ServiceUpdateListInput {
	# Operating system family of the agents whose services are listed (one of AgentOperatingSystemList.names).
	# Absent: the agents of all operating systems; empty: the agents that did not report their operating system.
	operatingSystem: String
}

# Operating system families the agents are installed on, derived from the operating systems reported by the agents.
type AgentOperatingSystemList {
	# Families present among the agents, in this order: "Windows", "Linux", "macOS", "Other" (unrecognized operating system)
	names: [String]
	# Some agents did not report their operating system
	hasUnknown: Boolean
}

# A version of a service type uploaded to the server: a row of the versions page of a service
# (opened by a double click on the "Update" page). The versions of one service type are requested
# with the "serviceTypeId" request header, the versions of one operating system family with the
# "operatingSystem" header (absent or empty: all of them; see CServiceVersionCollectionControllerComp).
type ServiceVersionItem {
	id: ID!
	typeId: ID!
	name: String
	# Operating system family the version is built for (one of AgentOperatingSystemList.names)
	operatingSystem: String
	version: String
	uploadDate: String
	# Path of the folder of the version on the server
	path: String
	# Number of agents having this version of the service type installed
	installationCount: Int
}

# A version of a service type added to the server: the folder of the version, its name is the version.
# The upload date is set by the server.
type ServiceVersionData {
	id: ID
	serviceTypeId: ID!
	# Operating system family the version is built for (one of AgentOperatingSystemList.names)
	operatingSystem: String!
	version: String!
	path: String!
}

input ServiceVersionDataInput {
	id: ID
	# Name of the collection element: the version
	name: String
	item: ServiceVersionData!
}

input ServiceVersionListInput {
	viewParams: CollectionViewParams
}

type ServiceVersionListPayload {
	items: [ServiceVersionItem]!
	# Required for web fromObject() (see AgentListPayload).
	notification: NotificationItem
}

# The folder on the server the versions of a service type for an operating system family are chosen in
# ("Set service folder" of the versions page). "Add" chooses the versions inside it.
type ServiceVersionFolder {
	serviceTypeId: ID
	operatingSystem: String
	# Empty if the folder is not set
	path: String
}

input ServiceVersionFolderInput {
	serviceTypeId: ID!
	# Operating system family (one of AgentOperatingSystemList.names)
	operatingSystem: String!
}

input SetServiceVersionFolderInput {
	serviceTypeId: ID!
	# Operating system family (one of AgentOperatingSystemList.names)
	operatingSystem: String!
	# An existing folder on the server
	path: String!
}

# "Install" of the versions page: the version is installed on the services of its type on the chosen agents.
input InstallServiceVersionInput {
	# ID of the version (an element of the "ServiceVersions" collection)
	versionId: ID!
	# The agents to install the version on
	agentIds: [ID]
}

# The installation of a version on one service of an agent.
type ServiceVersionInstallation {
	agentId: ID
	agentName: String
	# Empty if the agent has no service of the type of the version
	serviceId: ID
	serviceName: String
	# The agent was asked to install the version (UpdateServiceVersion of Services.sdl); the agent
	# downloads, stops, unpacks and starts the service on its own and reports to its log
	started: Boolean
	# Why the installation was not started
	message: String
}

type InstallServiceVersionPayload {
	version: String
	# Path of the folder of the version on the server, as sent to the agents
	path: String
	installations: [ServiceVersionInstallation]
}

# The files of the folder of a version, requested by an agent installing the version.
# Only the folders of the versions added to the server (ServiceVersionItem.path) are given.
input ServiceVersionFilesInput {
	# Path of the folder of the version on the server
	path: String!
}

type ServiceVersionFile {
	# Name of a file inside the folder of the version (the folder itself, no subfolders)
	name: String
	size: LongLong
}

type ServiceVersionFileList {
	path: String
	files: [ServiceVersionFile]
}

# A part of a file of the folder of a version (see ServiceVersionFilesInput).
input ServiceVersionFileChunkInput {
	# Path of the folder of the version on the server
	path: String!
	# Name of the file inside the folder
	fileName: String!
	offset: LongLong!
	# Number of bytes requested; the server gives at most 1 MB
	size: Int!
}

type ServiceVersionFileChunk {
	fileName: String
	offset: LongLong
	# The bytes of the part, Base64-encoded; empty at the end of the file
	content: String
	# Size of the whole file
	fileSize: LongLong
}

type Query {
	ServiceUpdatesList (input: ServiceUpdateListInput): ServiceUpdateListPayload!
	AgentOperatingSystemsList: AgentOperatingSystemList!
	ServiceVersionsList (input: ServiceVersionListInput): ServiceVersionListPayload!
	GetServiceVersionFolder (input: ServiceVersionFolderInput): ServiceVersionFolder!
	# Requested by an agent installing a version (header "clientid": an approved agent)
	GetServiceVersionFiles (input: ServiceVersionFilesInput): ServiceVersionFileList!
	# Requested by an agent installing a version (header "clientid": an approved agent)
	GetServiceVersionFileChunk (input: ServiceVersionFileChunkInput): ServiceVersionFileChunk!
}

type Mutation {
	# Add a version (a folder on the server) to the versions of a service type
	AddServiceVersion (input: ServiceVersionDataInput): AddedNotificationPayload!
	# Set the folder the versions of a service type for an operating system family are chosen in
	SetServiceVersionFolder (input: SetServiceVersionFolderInput): ServiceVersionFolder!
	# Install a version on the agents: every service of the type of the version on each agent is updated
	InstallServiceVersion (input: InstallServiceVersionInput): InstallServiceVersionPayload!
}

collectionSchema {
	type ServiceVersion {
		ref: ServiceVersionItem
		operations {
			list: ServiceVersionsList
		}
		subtype ServiceVersion {
			ref: ServiceVersionData
			operations {
				insert: AddServiceVersion
			}
		}
	}
}
