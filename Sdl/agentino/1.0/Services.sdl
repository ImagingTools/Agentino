schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: agentino
	version: 1.0
}

import {
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtCollection.sdl"
	"../../../../ImtCore/Sdl/imtbase/1.0/ImtBaseTypes.sdl"
}

type ServiceListInputViewParams {
	count: Int
	offset: Int
	filterModel: String
}

input ServiceListInput {
	viewParams: ServiceListInputViewParams
}

type ServiceItem {
	id: ID!
	typeId: ID!
	name: String!
	description: String
	path: String
	status: String
	version: String
}

type ServiceListPayload{
	items: [ServiceItem]!
	# ListObjects returns pagesCount/totalCount; required for web fromObject() (see AgentListPayload).
	notification: NotificationItem
}

type ExternConnectionInfo {
	id: ID
	description: String
	connectionParam: ServerConnectionParam
}

type InputConnection {
	id: ID
	connectionName: String
	description: String
	serviceTypeId: String
	externConnectionList: [ExternConnectionInfo]
	connectionParam: ServerConnectionParam
	# The service receives the servers of other products through it: it registers them as clients and issues their tokens.
	# Declared by the plugin of the service, the agent fills it.
	acceptsServerTokens: Boolean
}

type DependantConnectionInfo {
	id: ID
	name: String
	connectionParam: ServerConnectionParam
}

# Candidate producers for one output connection, keyed by that connection's usage id
# (the id shared between a consumer's output link and a compatible producer's input).
type OutputConnectionCandidates {
	connectionUsageId: ID!
	candidates: [DependantConnectionInfo]
}

input AvailableConnectionsInput {
	connectionUsageIds: [ID]
}

type AvailableConnectionsPayload {
	outputConnections: [OutputConnectionCandidates]!
}

type OutputConnection {
	id: ID
	connectionName: String
	description: String
	serviceName: String
	serviceTypeId: String
	dependantConnectionId: String
	connectionParam: ServerConnectionParam
}

type ServiceData {
	id: ID!
	name: String!
	description: String
	path: String
	arguments: String
	serviceTypeId: String
	enableVerbose: Boolean
	isAutoStart: Boolean
	tracingLevel: Integer
	startScript: String
	stopScript: String
	settingsPath: String
	version: String
	status: String
	inputConnections: [InputConnection]
	outputConnections: [OutputConnection]
}

input ServiceDataInput {
	id: ID!
	item: ServiceData!
}

input ConnectionUrlInput {
	serviceId: ID!
	connectionId: ID!
	connectionParam: ServerConnectionParam!
}

type UpdateConnectionUrlResponse {
	succesful: Boolean
}

# Standalone, immediate-apply pick of a producer for one Output Connection slot -
# independent of the rest of ServiceData, so choosing a connection does not require
# saving the whole service record. connectionParam is resolved by the server (which can
# see across the whole fleet) and forwarded to the owning agent; clients only ever send
# dependantConnectionId (empty clears the selection).
input SetOutputConnectionInput {
	serviceId: ID!
	connectionId: ID!
	dependantConnectionId: String
	connectionParam: ServerConnectionParam
}

type SetOutputConnectionResponse {
	succesful: Boolean
	connectionParam: ServerConnectionParam
}

enum ServiceStatus {
	UNDEFINED
	STARTING
	STOPPING
	RUNNING
	NOT_RUNNING
	RUNNING_IMPOSSIBLE
}

type ServiceInput {
	serviceId: ID!
}

type ServiceStatusResponse {
	status: ServiceStatus!
}

type LoadPluginInput {
	servicePath: String!
}

type ServiceSettingsPayload {
	serviceId: ID
	path: String
	content: String
	exists: Boolean
}

type ClearServiceLogPayload {
	success: Boolean!
}

input ServiceSettingsInput {
	serviceId: ID!
	content: String!
}

input ClearServiceInput {
	serviceId: ID!
}

type PluginInfo {
	servicePath: String!
	inputConnections: [InputConnection]
	outputConnections: [OutputConnection]
}

# Update a service to a version of its service type uploaded to the server: sent by the server to the
# agent for "Install" of the versions page (InstallServiceVersion of Updates.sdl). The agent downloads
# the archives of the version (the *.zip files of the folder of the version) from the server over HTTP
# by the URLs given here into the folder of the executable of the service, stops the service, unpacks
# the archives there, starts the service and removes the archives.
input UpdateServiceVersionInput {
	serviceId: ID!
	# The version, e.g. "1.0.0.513"
	version: String!
	# URLs of the archives of the version on the HTTP server of the Agentino server
	# (<server>/Agentino/ServiceVersions/<version ID>/<file name>, requested with the header "clientid").
	# A URL without a host (path only) is resolved against the HTTP address of the server the agent is
	# connected to, as well as a URL whose host is a loopback or unspecified address.
	urls: [String]
}

type UpdateServiceVersionResponse {
	# The update was started: it goes on in the agent, which reports the result to its log
	started: Boolean!
}

type Query {
	ServicesList (input: ServiceListInput): ServiceListPayload!
	GetService (input: InputId): ServiceData!
	GetServiceLog (input: CollectionViewParams): MessageListPayload!
	GetServiceStatus (input: InputId): ServiceStatusResponse!
	GetServiceSettings (input: ServiceInput): ServiceSettingsPayload!
	AvailableConnections (input: AvailableConnectionsInput): AvailableConnectionsPayload!
}

type Mutation {
	LoadPlugin (input: LoadPluginInput): PluginInfo!
	UpdateService (input: ServiceDataInput): UpdatedNotificationPayload!
	AddService (input: ServiceDataInput): AddedNotificationPayload!
	
	StartService (input: ServiceInput): ServiceStatusResponse!
	StopService (input: ServiceInput): ServiceStatusResponse!
	ClearServiceLog (input: ClearServiceInput): ClearServiceLogPayload!
	
	ServicesRemove (input: RemoveElementsInput): RemovedNotificationPayload!
	UpdateConnectionUrl (input: ConnectionUrlInput): UpdateConnectionUrlResponse!
	UpdateServiceSettings (input: ServiceSettingsInput): ServiceSettingsPayload!
	SetOutputConnection (input: SetOutputConnectionInput): SetOutputConnectionResponse!
	UpdateServiceVersion (input: UpdateServiceVersionInput): UpdateServiceVersionResponse!
}

collectionSchema {
	type ServiceLog {
		ref: MessageItem
		operations {
			list: GetServiceLog
		}
	}

	type Service {
		ref: ServiceItem
		operations {
			list: ServicesList
		}
		subtype Service {
			ref: ServiceData
			operations {
				get: GetService
				update: UpdateService
				insert: AddService
			}
		}
	}
}
