schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
	namespace: agentino
	version: 1.0
}

enum ShellType {
	CMD
	POWERSHELL
	BASH
	SH
}

enum TerminalStreamType {
	STDOUT
	STDERR
	SYSTEM
}

type ShellTypeInfo {
	type: ShellType!
	name: String!
	available: Boolean!
}

type ShellTypeListPayload {
	items: [ShellTypeInfo]!
}

input OpenTerminalSessionInput {
	shellType: ShellType!
}

type OpenTerminalSessionResponse {
	sessionId: ID!
	shellType: ShellType!
	started: Boolean!
}

input SendTerminalInputInput {
	sessionId: ID!
	data: String!
}

type SendTerminalInputResponse {
	accepted: Boolean!
}

# Writes terminal bytes verbatim without adding Enter. Used for VT key sequences
# from full-screen terminal applications such as mc, vim and top.
input SendTerminalRawInputInput {
	sessionId: ID!
	data: String!
}

type SendTerminalRawInputResponse {
	accepted: Boolean!
}

input CloseTerminalSessionInput {
	sessionId: ID!
}

type CloseTerminalSessionResponse {
	closed: Boolean!
}

# Best-effort interrupt (Ctrl+C / SIGINT) of the shell's foreground work without
# destroying the session. Cursor/TUI programs may ignore it.
input InterruptTerminalSessionInput {
	sessionId: ID!
}

type InterruptTerminalSessionResponse {
	accepted: Boolean!
}

# Tells the agent the GUI's visible character grid so curses/full-screen programs
# draw correctly. Best-effort; a session with no PTY (should not happen) just no-ops.
input ResizeTerminalSessionInput {
	sessionId: ID!
	columns: Integer!
	rows: Integer!
}

type ResizeTerminalSessionResponse {
	resized: Boolean!
}

input TerminalOutputInput {
	sessionId: ID!
	fromSequence: Integer
}

type TerminalOutputChunk {
	sequence: Integer!
	stream: TerminalStreamType!
	data: String!
}

# 'running' is false both for a shell that has exited and for a session the agent does
# not know (any more) - in either case the client must stop polling and show exitCode.
# There is deliberately no 'finished' field: the generated QObject wrapper inherits
# imtbase::CItemModelBase, which already declares a 'finished' signal.
#
# 'upstreamHealthy' is absent/true on every real payload relayed from the agent; the
# server proxy sets it to false only in a synthetic payload it manufactures itself
# (chunks empty, sessionId/nextSequence carried over from the last real payload) when
# the server<->agent push subscription is lost, so the GUI's reconnect state reflects
# the whole chain rather than just the GUI<->server WebSocket link.
type TerminalOutputResponse {
	sessionId: ID!
	chunks: [TerminalOutputChunk]!
	nextSequence: Integer!
	running: Boolean!
	exitCode: Integer
	upstreamHealthy: Boolean
}

type Query {
	ListShellTypes: ShellTypeListPayload!
	GetTerminalOutput (input: TerminalOutputInput): TerminalOutputResponse!
}

type Mutation {
	OpenTerminalSession (input: OpenTerminalSessionInput): OpenTerminalSessionResponse!
	SendTerminalInput (input: SendTerminalInputInput): SendTerminalInputResponse!
	SendTerminalRawInput (input: SendTerminalRawInputInput): SendTerminalRawInputResponse!
	InterruptTerminalSession (input: InterruptTerminalSessionInput): InterruptTerminalSessionResponse!
	ResizeTerminalSession (input: ResizeTerminalSessionInput): ResizeTerminalSessionResponse!
	CloseTerminalSession (input: CloseTerminalSessionInput): CloseTerminalSessionResponse!
}

# Pushed by the agent whenever a session produces new output. The publisher sends every
# buffered chunk from fromSequence onward as soon as the subscription registers, so the
# subscribe call itself is the catch-up - there is no window between opening a session
# and seeing its output. GetTerminalOutput remains only for gap recovery after a dropped
# and re-established subscription (client-driven reconnect).
input TerminalOutputSubscriptionInput {
	sessionId: ID!
	fromSequence: Integer
}

type Subscription {
	OnTerminalOutputChanged (input: TerminalOutputSubscriptionInput): TerminalOutputResponse!
}
