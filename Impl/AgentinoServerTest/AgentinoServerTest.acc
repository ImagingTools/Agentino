                    </AttributeInfo>
                    <AttributeInfo Id="SqlLogFilePath" Type="String" ExportId="">
                        <Data IsEnabled="true" Value="Agentino/Agentino Server/AgentinoServerTestLog.sqlite"/>
                    </AttributeInfo>
                    <AttributeInfo Id="VersionInfo" Type="Reference" ExportId="">
                        <Data IsEnabled="true" Value="VersionInfo"/>
                    </AttributeInfo>
                </AttributeInfoMap>
            </Data>
        </Element>
        <Element Id="Server" PackageId="AgentinoVoce" ComponentId="ServerBase">
